# Copiar a .env en la raíz. Generar una clave local; no reutilizar en producción.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vacío: SQLite local. Vercel Production: Neon pooled con TLS (ejemplo ficticio):
# postgresql://USUARIO:CLAVE@ep-EJEMPLO-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Para migrate desde Ubuntu copiar la conexión DIRECTA de Neon, sin -pooler.
DATABASE_URL=
# Neon CLI escribe también la URL directa para migraciones manuales.
# No la consume el servidor web. Uso: npm run db:migrate -- --plan
DATABASE_URL_UNPOOLED=
# Activar solamente detrás de un proxy confiable que reescriba X-Forwarded-Proto.
DJANGO_TRUST_PROXY=False
# Permite una carga explícita de datos ficticios en el entorno de evaluación.
# No carga datos al arrancar. Desactivar tras inicializar la demo.
SAP_DEMO_MODE=False

# No copiar este archivo a Vercel. Configurar en el panel, sólo en Production:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=sap-bice.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://sap-bice.vercel.app
# DJANGO_SECRET_KEY=<nueva clave aleatoria, distinta de la local>
# DATABASE_URL=<URL pooled real, privada>
# VERCEL=1 la aporta Vercel: deshabilita .env/DEBUG y activa el proxy HTTPS.
# DJANGO_TRUST_PROXY no es necesario allí. Preview se omite por defecto.
# Procedimiento completo: docs/despliegue-vercel.md
